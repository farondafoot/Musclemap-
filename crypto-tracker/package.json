{
  "name": "crypto-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "monitor": "ts-node --project tsconfig.json src/monitor/index.ts",
    "monitor:dev": "nodemon --exec ts-node --project tsconfig.json src/monitor/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "ts-node src/scripts/seed.ts",
    "wallet:add": "ts-node src/scripts/wallet-add.ts",
    "wallet:list": "ts-node src/scripts/wallet-list.ts",
    "wallet:remove": "ts-node src/scripts/wallet-remove.ts",
    "score:update": "ts-node src/scripts/score-update.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@solana/web3.js": "^1.95.4",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "node-telegram-bot-api": "^0.66.0",
    "p-limit": "^5.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/node-telegram-bot-api": "^0.64.7",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prisma": "^5.14.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
