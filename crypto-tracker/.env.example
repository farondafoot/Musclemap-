# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://crypto:crypto_secret@localhost:5432/crypto_tracker"

POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto_secret
POSTGRES_DB=crypto_tracker
POSTGRES_PORT=5432

# ── Solana RPC ────────────────────────────────────────────
# Helius gives you a fast RPC + enhanced transaction parsing
# Get a free key at https://helius.dev
HELIUS_API_KEY=

# Fallback public RPC (rate-limited; prefer Helius)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Token / Price APIs ────────────────────────────────────
# Birdeye — optional, better price data on Solana
# Get a free key at https://birdeye.so
BIRDEYE_API_KEY=

# DexScreener is used automatically (no key required)

# ── Telegram ──────────────────────────────────────────────
# 1. Create a bot via @BotFather → get TELEGRAM_BOT_TOKEN
# 2. Send a message to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Monitor settings ──────────────────────────────────────
# How often to poll each wallet (milliseconds)
POLL_INTERVAL_MS=30000

# Minimum wallet score to trigger an alert (0-100)
ALERT_MIN_SCORE=50

# Minimum trade size in USD to trigger an alert
ALERT_MIN_TRADE_USD=500

# ── Risk thresholds ───────────────────────────────────────
RISK_MIN_LIQUIDITY_USD=50000
RISK_MAX_TOKEN_AGE_MINUTES=30
RISK_MAX_HOLDER_CONCENTRATION=0.5

# ── Dashboard ─────────────────────────────────────────────
DASHBOARD_PORT=3000

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
