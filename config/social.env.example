# MuscleMap — Social Media API Credentials
# Copy this file to config/social.env and fill in your keys.
# NEVER commit social.env to git (it's in .gitignore).

# ── Ollama (local — no keys needed) ───────────────────────────────────────
OLLAMA_URL=http://localhost:11434
CONTENT_MODEL=llama3.2

# ── YouTube Data API v3 ────────────────────────────────────────────────────
# Setup: console.cloud.google.com → new project → enable YouTube Data API v3
#        → OAuth 2.0 credentials → run oauth flow once to get tokens
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_ACCESS_TOKEN=
YT_REFRESH_TOKEN=

# ── Instagram Graph API ────────────────────────────────────────────────────
# Setup: developers.facebook.com → new app → Instagram product
#        → connect your Instagram Business account
# Note: Instagram requires videos to be hosted at a public URL for upload.
#       Use any free CDN/storage (e.g. Cloudflare R2 free tier, Backblaze B2).
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_VIDEO_HOSTING_URL=    # Public URL where you upload the .mp4 before posting

# ── TikTok for Developers ──────────────────────────────────────────────────
# Setup: developers.tiktok.com → new app → Content Posting API
#        → OAuth flow to get access token
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
