# MuscleMap — pipeline credentials
# Copy to config/social.env and fill in. social.env is gitignored.

# ── Ollama (local — no key needed) ─────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
CONTENT_MODEL=llama3.2

# ── Postiz (handles all social posting) ────────────────────────────────────
# Setup instructions: see POSTIZ_SETUP.md
#
# You connect YouTube / Instagram / TikTok by clicking "Connect" in the Postiz
# web UI. Postiz owns the OAuth apps, so there is no Google Cloud Console,
# Facebook Developer app, or TikTok dev portal to set up.
#
# POSTIZ_URL must match NEXT_PUBLIC_BACKEND_URL in your Postiz .env.
# The script appends /public/v1 to it.
POSTIZ_URL=http://localhost:4007/api

# Postiz -> Settings -> Public API -> Generate
POSTIZ_API_KEY=
